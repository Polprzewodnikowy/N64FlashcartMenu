{
    "name": "N64FlashcartMenu-docbuilder",
    "build": {
        "dockerfile": "Dockerfile.docbuilder"
    },
    "remoteEnv": {
        "PATH": "${containerEnv:PATH}:/root/.dotnet/tools"
    },
    "mounts": [
        "source=n64flashcartmenu-docbuilder-bashhistory,target=/commandhistory,type=volume"
    ],
    "postCreateCommand": "dotnet tool update -g docfx && git submodule update --init && cd ./libdragon && ./build.sh --no-examples",
    "customizations": {
        "vscode": {
            "settings": {
                "git.ignoredRepositories": [
                    "libdragon",
                    "src/libs/libspng",
                    "src/libs/minimp3",
                    "src/libs/miniz",
                    "src/libs/dr_libs",
                    "src/libs/libjpeg-turbo"
                ]
            }
        }
    }
}
